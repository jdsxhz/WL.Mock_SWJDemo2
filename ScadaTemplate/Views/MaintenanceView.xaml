<UserControl x:Class="ScadaTemplate.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScadaTemplate.Controls">
    <Grid Margin="24,8,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>
        <controls:TechPanel Header="设备维护">
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="108" Margin="6" BorderBrush="#355D82" BorderThickness="1" Background="#62122D45">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <controls:StatusLamp Status="{Binding Status}" Width="20" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#9FC7DC" VerticalAlignment="Center" />
                                <ProgressBar Grid.Row="2" Value="{Binding Value}" Maximum="100" Height="10" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:TechPanel>
        <controls:TechPanel Grid.Column="1" Header="保养计划" Margin="16,0,0,0">
            <StackPanel>
                <TextBlock Text="泵1：剩余 126 小时" FontSize="18" FontWeight="Bold" Margin="0,10" />
                <TextBlock Text="泵2：剩余 184 小时" FontSize="18" FontWeight="Bold" Margin="0,10" />
                <TextBlock Text="过滤器1：建议本周清洗" FontSize="18" Foreground="#FCD640" FontWeight="Bold" Margin="0,10" />
                <TextBlock Text="过滤器2：运行正常" FontSize="18" Foreground="#8DFFBE" FontWeight="Bold" Margin="0,10" />
                <Button Content="生成维护工单" Command="{Binding CreateWorkOrderCommand}" Style="{StaticResource TechButtonStyle}" HorizontalAlignment="Left" Margin="0,24,0,0" />
            </StackPanel>
        </controls:TechPanel>
    </Grid>
</UserControl>

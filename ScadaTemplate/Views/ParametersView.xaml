<UserControl x:Class="ScadaTemplate.Views.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScadaTemplate.Controls">
    <Grid Margin="24,8,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <controls:TechPanel Header="工艺参数配置">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <Grid Background="#4A123A5A">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="参数名称" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="设定值" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Text="单位" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Grid.Column="3" Text="下限" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Grid.Column="4" Text="上限" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="48" BorderBrush="#2B668B" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="160" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Unit}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Minimum}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9FC7DC" />
                                    <TextBlock Grid.Column="4" Text="{Binding Maximum}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9FC7DC" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="读取参数" Command="{Binding ReadParametersCommand}" Style="{StaticResource TechButtonStyle}" />
                    <Button Content="参数下发" Command="{Binding ApplyParametersCommand}" Style="{StaticResource TechButtonStyle}" Background="#148660" BorderBrush="#24D69B" />
                </StackPanel>
            </Grid>
        </controls:TechPanel>

        <controls:TechPanel Grid.Column="1" Header="Modbus 通讯状态" Margin="16,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Columns="2" Rows="3">
                    <TextBlock Text="{Binding ModbusHost, StringFormat=地址 {0}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ModbusPort, StringFormat=端口 {0}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ModbusUnitId, StringFormat=站号 {0}}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ParameterStartAddress, StringFormat=起始寄存器 {0}}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ParameterA, StringFormat=进料 {0:0.#} CM}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ParameterB, StringFormat=回流 {0:0.#} CM}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </UniformGrid>

                <Border Grid.Row="1" BorderBrush="#355D82" BorderThickness="1" Background="#62122D45" Padding="18">
                    <StackPanel>
                        <TextBlock Text="参数读写流程" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="1. 设置 Modbus TCP 地址、端口、站号和起始寄存器。" Margin="0,18,0,0" />
                        <TextBlock Text="2. 点击读取参数，使用功能码 03 读取保持寄存器。" Margin="0,10,0,0" />
                        <TextBlock Text="3. 修改设定值后点击参数下发，使用功能码 16 批量写入保持寄存器。" Margin="0,10,0,0" />
                        <TextBlock Text="4. 后续按客户寄存器表增加比例系数、浮点格式和地址映射。" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding OperationMessage}" Foreground="#83DDF1" TextWrapping="Wrap" Margin="0,28,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </controls:TechPanel>
    </Grid>
</UserControl>

<UserControl x:Class="ScadaTemplate.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScadaTemplate.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="188" />
        </Grid.RowDefinitions>

        <Grid Margin="24,8,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <controls:TechPanel Header="设备状态">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="#4A123A5A">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备名称" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="状态" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="数值" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="30" BorderBrush="#2B668B" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <controls:StatusLamp Status="{Binding Status}" Width="18" Height="18" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:0.#}}" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </controls:TechPanel>

            <controls:TechPanel Grid.Column="1" Header="工艺流程" Margin="16,0">
                <Grid>
                    <controls:ProcessDiagram Margin="4,0,4,54"
                                             IsRunning="{Binding IsRunning}"
                                             Valve1Open="{Binding Valve1Open}"
                                             Valve2Open="{Binding Valve2Open}"
                                             Pump1Running="{Binding Pump1Running}"
                                             Pump2Running="{Binding Pump2Running}"
                                             TankTemperature1="{Binding TankTemperature1}"
                                             TankTemperature2="{Binding TankTemperature2}"
                                             InletTemperature="{Binding InletTemperature}"
                                             OutletTemperature="{Binding OutletTemperature}"
                                             FilterLevel1="{Binding FilterLevel1}"
                                             FilterLevel2="{Binding FilterLevel2}" />

                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="410" Margin="0,14,8,0"
                            Background="#90132B42" BorderBrush="#5B9FD7" BorderThickness="1">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="实时报警" FontWeight="Bold" FontSize="15" DockPanel.Dock="Left" />
                                <Button Content="确认" Command="{Binding AcknowledgeAlarmCommand}" Style="{StaticResource TechButtonStyle}" Height="26" Width="72" HorizontalAlignment="Right" />
                            </DockPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="△" Foreground="#FCD640" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#C6DCE8" VerticalAlignment="Center" FontSize="11" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#C6DCE8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Content}" Foreground="#C6DCE8" VerticalAlignment="Center" />
                                            <Button Grid.Column="4"
                                                    Content="确认"
                                                    Command="{Binding DataContext.AcknowledgeSingleAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TechButtonStyle}"
                                                    Width="52"
                                                    Height="24"
                                                    FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border VerticalAlignment="Bottom" Height="46" Background="#72122D45" BorderBrush="#355D82" BorderThickness="1" Margin="120,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="系统启动" Command="{Binding StartCommand}" Style="{StaticResource TechButtonStyle}" Background="#148660" BorderBrush="#24D69B" />
                            <Button Content="系统复位" Command="{Binding ResetCommand}" Style="{StaticResource TechButtonStyle}" />
                            <Button Content="系统停止" Command="{Binding StopCommand}" Style="{StaticResource TechButtonStyle}" Background="#9A294B" BorderBrush="#F04E70" />
                            <TextBlock Text="{Binding OperationMessage}" Foreground="#86E7F5" VerticalAlignment="Center" Margin="22,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:TechPanel>

            <controls:TechPanel Grid.Column="2" Header="信息统计">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="设备名称:" FontWeight="Bold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice}" />
                        </Grid>
                        <UniformGrid Columns="2" Rows="2">
                            <TextBlock Text="{Binding TankTemperature1, StringFormat=罐1温度 {0:0.0}°C}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding TankTemperature2, StringFormat=罐2温度 {0:0.0}°C}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding FilterLevel1, StringFormat=滤器1 {0:0}%}" Foreground="#8DFFBE" FontWeight="Bold" />
                            <TextBlock Text="{Binding FilterLevel2, StringFormat=滤器2 {0:0}%}" Foreground="#8DFFBE" FontWeight="Bold" />
                        </UniformGrid>
                    </StackPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Parameters}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Unit}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="读取参数" Command="{Binding ReadParametersCommand}" Style="{StaticResource TechButtonStyle}" />
                        <Button Content="参数下发" Command="{Binding ApplyParametersCommand}" Style="{StaticResource TechButtonStyle}" />
                        <Button Content="报警确认" Command="{Binding AcknowledgeAlarmCommand}" Style="{StaticResource TechButtonStyle}" />
                    </StackPanel>
                </Grid>
            </controls:TechPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="2.3*" />
            </Grid.ColumnDefinitions>
            <controls:TechPanel Header="快捷参数">
                <StackPanel>
                    <Grid Margin="8,0,8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="进料:" VerticalAlignment="Center" FontWeight="Bold" />
                        <TextBox Grid.Column="1" Text="{Binding ParameterA, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="/cm" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="8,0,8,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="回流:" VerticalAlignment="Center" FontWeight="Bold" />
                        <TextBox Grid.Column="1" Text="{Binding ParameterB, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="/cm" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Button Content="下发" Command="{Binding ApplyParametersCommand}" Style="{StaticResource TechButtonStyle}" HorizontalAlignment="Center" Width="110" />
                </StackPanel>
            </controls:TechPanel>
            <controls:TechPanel Grid.Column="1" Header="开关显示" Margin="16,0,0,0">
                <ItemsControl ItemsSource="{Binding Switches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" Rows="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:StatusLamp Status="{Binding Status}" Width="20" Height="20" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:TechPanel>
            <controls:TechPanel Grid.Column="2" Header="模式状态" Margin="16,0,0,0">
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:StatusLamp Status="{Binding Status}" Width="20" Height="20" Margin="0,0,18,0" />
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:TechPanel>
            <controls:TechPanel Grid.Column="3" Header="运行摘要" Margin="16,0,0,0">
                <UniformGrid Columns="3" Rows="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="泵1" FontWeight="Bold" HorizontalAlignment="Center" />
                        <controls:StatusLamp Status="{Binding SystemStateStatus}" Width="28" Height="28" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="泵2" FontWeight="Bold" HorizontalAlignment="Center" />
                        <controls:StatusLamp Status="{Binding SystemStateStatus}" Width="28" Height="28" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="阀门" FontWeight="Bold" HorizontalAlignment="Center" />
                        <controls:StatusLamp Status="{Binding SystemStateStatus}" Width="28" Height="28" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding InletTemperature, StringFormat=入口 {0:0.0}°C}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OutletTemperature, StringFormat=出口 {0:0.0}°C}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OperationMessage}" Foreground="#83DDF1" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" />
                </UniformGrid>
            </controls:TechPanel>
        </Grid>
    </Grid>
</UserControl>

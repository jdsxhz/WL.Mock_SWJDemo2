<UserControl x:Class="ScadaTemplate.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScadaTemplate.Controls">
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="142" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TechPanel Header="Modbus TCP 通讯">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="PLC 地址" FontWeight="Bold" />
                    <TextBox Text="{Binding ModbusHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="端口" FontWeight="Bold" />
                    <TextBox Text="{Binding ModbusPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="站号" FontWeight="Bold" />
                    <TextBox Text="{Binding ModbusUnitId, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="超时/状态" FontWeight="Bold" />
                    <TextBlock Text="{Binding OperationMessage}" Foreground="#83DDF1" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="测试连接" Command="{Binding TestConnectionCommand}" Style="{StaticResource TechButtonStyle}" />
                    <Button Content="读取全部" Command="{Binding ReadParametersCommand}" Style="{StaticResource TechButtonStyle}" />
                    <Button Content="写入可写点" Command="{Binding ApplyParametersCommand}" Style="{StaticResource TechButtonStyle}" Background="#148660" BorderBrush="#24D69B" />
                    <Button Content="保存配置" Command="{Binding SaveSettingsCommand}" Style="{StaticResource TechButtonStyle}" />
                    <Button Content="重新加载" Command="{Binding ReloadSettingsCommand}" Style="{StaticResource TechButtonStyle}" />
                </StackPanel>
            </Grid>
        </controls:TechPanel>

        <controls:TechPanel Grid.Row="1" Header="Modbus 点位配置" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="新增点位" Command="{Binding AddModbusPointCommand}" Style="{StaticResource TechButtonStyle}" />
                        <Button Content="删除点位" Command="{Binding RemoveModbusPointCommand}" Style="{StaticResource TechButtonStyle}" Background="#713044" BorderBrush="#BA526B" />
                    </StackPanel>
                    <TextBlock Text="地址采用协议零基地址；40001 在此填写 0。Float32/UInt32 占 2 个寄存器，Float64 占 4 个。"
                               Foreground="#9FC7DC"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ModbusPoints}"
                          SelectedItem="{Binding SelectedModbusPoint}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="#50112A42"
                          Foreground="#D9F5FF"
                          BorderBrush="#355D82"
                          RowBackground="#40132942"
                          AlternatingRowBackground="#6017334E"
                          HorizontalGridLinesBrush="#2B668B"
                          RowHeight="38">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#174B70" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Height" Value="36" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="6,2" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="点位名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" />

                        <DataGridTemplateColumn Header="寄存器区" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.RegisterAreas, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Area, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="地址" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="80" />

                        <DataGridTemplateColumn Header="数据类型" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.ModbusDataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="寄存器数" Binding="{Binding RegisterCount}" IsReadOnly="True" Width="80" />
                        <DataGridTextColumn Header="倍率" Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" Width="80" />

                        <DataGridTemplateColumn Header="字节序" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.ByteOrders, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding ByteOrder, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="字序" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.WordOrders, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding WordOrder, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="当前值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}" Width="110" />
                        <DataGridCheckBoxColumn Header="允许写入" Binding="{Binding CanWrite, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2">
                    <TextBlock Text="BigEndian：寄存器内高字节在前；LittleEndian：寄存器内低字节在前。HighWordFirst/LowWordFirst 控制多寄存器字序。"
                               Foreground="#82B6CF"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ModbusPoints.Count, StringFormat=点位数量：{0}}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                </Grid>
            </Grid>
        </controls:TechPanel>
    </Grid>
</UserControl>

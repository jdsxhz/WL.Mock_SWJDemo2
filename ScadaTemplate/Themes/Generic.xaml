<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ScadaTemplate.Controls"
                    xmlns:models="clr-namespace:ScadaTemplate.Models">
    <Style TargetType="{x:Type controls:StatusLamp}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusLamp}">
                    <Grid>
                        <Ellipse Fill="#11000000" Stroke="#244B66" StrokeThickness="1.5" />
                        <Ellipse x:Name="Glow" Width="23" Height="23" Opacity=".55">
                            <Ellipse.Effect>
                                <BlurEffect Radius="5" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Core" Width="12" Height="12" Stroke="#D7FFFF" StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Status" Value="{x:Static models:StatusKind.Normal}">
                            <Setter TargetName="Glow" Property="Fill" Value="#73FF2D" />
                            <Setter TargetName="Core" Property="Fill" Value="#73FF2D" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static models:StatusKind.Warning}">
                            <Setter TargetName="Glow" Property="Fill" Value="#32F6FF" />
                            <Setter TargetName="Core" Property="Fill" Value="#32F6FF" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static models:StatusKind.Error}">
                            <Setter TargetName="Glow" Property="Fill" Value="#FF3C46" />
                            <Setter TargetName="Core" Property="Fill" Value="#FF3C46" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static models:StatusKind.Offline}">
                            <Setter TargetName="Glow" Property="Fill" Value="#2E7DFF" />
                            <Setter TargetName="Core" Property="Fill" Value="#2E7DFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:TechPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TechPanel}">
                    <Grid>
                        <Border Margin="0,30,0,0"
                                Background="{StaticResource PanelFillBrush}"
                                BorderBrush="{StaticResource PanelLineBrush}"
                                BorderThickness="1" />
                        <Grid HorizontalAlignment="Left" Width="250" Height="38" VerticalAlignment="Top">
                            <Path Stretch="Fill"
                                  Fill="#174B7D"
                                  Stroke="#258EFF"
                                  StrokeThickness="1"
                                  Data="M0,0 L190,0 L230,38 L0,38 Z" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <Path Width="16" Height="16" Fill="#57B8FF" Stretch="Fill" Data="M0,0 L14,8 L0,16 Z" />
                                <TextBlock Text="{TemplateBinding Header}" FontSize="16" FontWeight="Bold" Margin="18,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ContentPresenter Margin="16,46,16,16" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ProcessDiagram}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="520" />
    </Style>
</ResourceDictionary>
